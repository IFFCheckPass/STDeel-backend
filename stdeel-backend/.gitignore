# Python 运行时生成物
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 运行时数据（不入库）：SQLite 数据库、WAL、上传文件、备份
app.db
app.db-wal
app.db-shm
data/
uploads/
backups/

# 管理台凭据（只存加盐哈希 + 会话密钥，绝不入库）
admin_auth.json
.admin_auth.*.tmp

# API Key 加密主密钥（32 字节 hex，0600；丢了等于已存的用户 Key 全部解不开）
api_key.key
.api_key.*.tmp

# 编辑器/系统杂物
.DS_Store
